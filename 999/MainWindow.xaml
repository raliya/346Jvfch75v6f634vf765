<Window x:Class="TextFileProcessor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Domain Site Deployment Manager — Сборка 4"
        Width="1320"
        Height="850"
        MinWidth="1050"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Loaded="Build4_Loaded"
        Closing="Window_Closing">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="190"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0"
                  Header="Папки"
                  Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="135"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Margin="0,0,8,7"
                           VerticalAlignment="Center"
                           Text="Исходная папка:"/>

                <TextBox x:Name="SourceFolderTextBox"
                         Grid.Row="0"
                         Grid.Column="1"
                         Margin="0,0,8,7"/>

                <Button Grid.Row="0"
                        Grid.Column="2"
                        Margin="0,0,0,7"
                        Padding="8,5"
                        Click="BrowseSource_Click"
                        Content="Выбрать..."/>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Text="Папка результата:"/>

                <TextBox x:Name="OutputFolderTextBox"
                         Grid.Row="1"
                         Grid.Column="1"
                         Margin="0,0,8,0"/>

                <Button Grid.Row="1"
                        Grid.Column="2"
                        Padding="8,5"
                        Click="BrowseOutput_Click"
                        Content="Выбрать..."/>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="1"
              Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.25*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Header="Домены — по одному на строку"
                      Margin="0,0,8,0">
                <TextBox x:Name="DomainsTextBox"
                         Margin="8"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"/>
            </GroupBox>

            <GroupBox Grid.Column="1"
                      Header="Значения №2 — строка к строке"
                      Margin="0,0,8,0">
                <TextBox x:Name="SecondValuesTextBox"
                         Margin="8"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"/>
            </GroupBox>

            <GroupBox Grid.Column="2"
                      Header="Правила замен">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Margin="0,0,8,8"
                               VerticalAlignment="Center"
                               Text="Искомый текст №1:"/>

                    <TextBox x:Name="SearchText1TextBox"
                             Grid.Row="0"
                             Grid.Column="1"
                             Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Margin="0,0,8,8"
                               VerticalAlignment="Center"
                               Text="Искомый текст №2:"/>

                    <TextBox x:Name="SearchText2TextBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             Margin="0,0,0,8"/>

                    <CheckBox x:Name="AdditionalExtensionsCheckBox"
                              Grid.Row="2"
                              Grid.ColumnSpan="2"
                              Margin="0,0,0,8"
                              Content="Также CSS, JS, JSON, XML, ENV, INI, CONF"/>

                    <CheckBox x:Name="ReplaceExistingCheckBox"
                              Grid.Row="3"
                              Grid.ColumnSpan="2"
                              Content="Безопасно заменять существующие папки"/>
                </Grid>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="2"
                    Margin="0,0,0,8"
                    Orientation="Horizontal">

            <Button x:Name="PreviewButton"
                    Width="135"
                    Margin="0,0,8,0"
                    Padding="10,6"
                    Click="Preview_Click"
                    Content="Предпросмотр"/>

            <Button x:Name="StartButton"
                    Width="135"
                    Margin="0,0,8,0"
                    Padding="10,6"
                    Click="Start_Click"
                    Content="Запустить"/>

            <Button x:Name="CancelButton"
                    Width="135"
                    Margin="0,0,8,0"
                    Padding="10,6"
                    IsEnabled="False"
                    Click="Cancel_Click"
                    Content="Остановить"/>

            <Button Width="155"
                    Padding="10,6"
                    Click="ClearJobs_Click"
                    Content="Очистить таблицу"/>
        </StackPanel>

        <TabControl Grid.Row="3"
                    Margin="0,0,0,8">

            <TabItem Header="ISPmanager">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Margin="0,0,10,9"
                                   VerticalAlignment="Center"
                                   Text="Адрес панели:"/>

                        <TextBox x:Name="IspmanagerUrlTextBox"
                                 Grid.Row="0"
                                 Grid.Column="1"
                                 Margin="0,0,0,9"
                                 Text="https://185.115.33.18:1500/ispmgr"/>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Margin="0,0,10,9"
                                   VerticalAlignment="Center"
                                   Text="Логин:"/>

                        <TextBox x:Name="IspmanagerLoginTextBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Margin="0,0,0,9"
                                 Text="root"/>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Margin="0,0,10,9"
                                   VerticalAlignment="Center"
                                   Text="Пароль:"/>

                        <StackPanel Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="0,0,0,9">
                            <PasswordBox x:Name="IspmanagerPasswordBox"/>
                            <TextBlock x:Name="PasswordSavedTextBlock"
                                       Margin="0,4,0,0"
                                       Foreground="#666666"
                                       Text="Пароль ещё не сохранён."/>
                        </StackPanel>

                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Margin="0,0,10,9"
                                   VerticalAlignment="Center"
                                   Text="Владелец сайта:"/>

                        <TextBox x:Name="IspmanagerOwnerTextBox"
                                 Grid.Row="3"
                                 Grid.Column="1"
                                 Margin="0,0,0,9"
                                 Text="www-root"/>

                        <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   Margin="0,0,10,9"
                                   VerticalAlignment="Center"
                                   Text="Версия PHP:"/>

                        <TextBox x:Name="IspmanagerPhpVersionTextBox"
                                 Grid.Row="4"
                                 Grid.Column="1"
                                 Margin="0,0,0,9"
                                 Text="8.3.8"/>

                        <CheckBox x:Name="IgnoreCertificateErrorsCheckBox"
                                  Grid.Row="5"
                                  Grid.ColumnSpan="2"
                                  Margin="0,0,0,8"
                                  IsChecked="True"
                                  Content="Разрешить сертификат панели с ошибкой проверки (панель открывается по IP)"/>

                        <CheckBox x:Name="ShowBrowserCheckBox"
                                  Grid.Row="6"
                                  Grid.ColumnSpan="2"
                                  Margin="0,0,0,12"
                                  IsChecked="True"
                                  Content="Показывать окно Chromium во время автоматизации"/>

                        <StackPanel Grid.Row="7"
                                    Grid.ColumnSpan="2"
                                    Orientation="Horizontal">
                            <Button x:Name="SaveIspmanagerSettingsButton"
                                    Width="170"
                                    Margin="0,0,8,0"
                                    Padding="10,6"
                                    Click="SaveIspmanagerSettings_Click"
                                    Content="Сохранить настройки"/>

                            <Button x:Name="TestIspmanagerButton"
                                    Width="180"
                                    Margin="0,0,8,0"
                                    Padding="10,6"
                                    Click="TestIspmanagerConnection_Click"
                                    Content="Проверить подключение"/>

                            <Button x:Name="CreateWebDomainButton"
                                    Width="225"
                                    Padding="10,6"
                                    Click="CreateSelectedWebDomain_Click"
                                    Content="Создать выбранный WWW-домен"/>
                        </StackPanel>

                        <Border Grid.Row="8"
                                Grid.ColumnSpan="2"
                                Margin="0,14,0,0"
                                Padding="10"
                                Background="#FFF1F1F1"
                                BorderBrush="#FFD0D0D0"
                                BorderThickness="1">
                            <TextBlock x:Name="Build2StatusTextBlock"
                                       TextWrapping="Wrap"
                                       Text="Сборка 2 ещё не проверена."/>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="SSH/SFTP">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
</Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Margin="0,0,10,9"
                                   VerticalAlignment="Center"
                                   Text="SSH-сервер:"/>

                        <TextBox x:Name="SshHostTextBox"
                                 Grid.Row="0"
                                 Grid.Column="1"
                                 Margin="0,0,0,9"/>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Margin="0,0,10,9"
                                   VerticalAlignment="Center"
                                   Text="SSH-порт:"/>

                        <TextBox x:Name="SshPortTextBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Margin="0,0,0,9"
                                 Text="22"/>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Margin="0,0,10,9"
                                   VerticalAlignment="Center"
                                   Text="SSH-пользователь:"/>

                        <TextBox x:Name="SshUsernameTextBox"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 Margin="0,0,0,9"
                                 Text="root"/>

                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Margin="0,0,10,9"
                                   VerticalAlignment="Center"
                                   Text="SSH-пароль:"/>

                        <StackPanel Grid.Row="3"
                                    Grid.Column="1"
                                    Margin="0,0,0,9">
                            <PasswordBox x:Name="SshPasswordBox"/>

                            <TextBlock x:Name="SshPasswordSavedTextBlock"
                                       Margin="0,4,0,0"
                                       Foreground="#666666"
                                       Text="SSH-пароль ещё не сохранён."/>
                        </StackPanel>

                        <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   Margin="0,0,10,9"
                                   VerticalAlignment="Center"
                                   Text="Host key SHA-256:"/>

                        <TextBox x:Name="SshFingerprintTextBox"
                                 Grid.Row="4"
                                 Grid.Column="1"
                                 Margin="0,0,0,9"/>

                        <TextBlock Grid.Row="5"
                                   Grid.Column="0"
                                   Margin="0,0,10,9"
                                   VerticalAlignment="Center"
                                   Text="Корень сайтов:"/>

                        <TextBox x:Name="SshRemoteRootTextBox"
                                 Grid.Row="5"
                                 Grid.Column="1"
                                 Margin="0,0,0,9"
                                 Text="/var/www/www-root/data/www"/>

                        <TextBlock Grid.Row="6"
                                   Grid.Column="0"
                                   Margin="0,0,10,9"
                                   VerticalAlignment="Center"
                                   Text="Владелец:"/>

                        <TextBox x:Name="SshOwnerTextBox"
                                 Grid.Row="6"
                                 Grid.Column="1"
                                 Margin="0,0,0,9"
                                 Text="www-root"/>

                        <TextBlock Grid.Row="7"
                                   Grid.Column="0"
                                   Margin="0,0,10,9"
                                   VerticalAlignment="Center"
                                   Text="Группа:"/>

                        <TextBox x:Name="SshGroupTextBox"
                                 Grid.Row="7"
                                 Grid.Column="1"
                                 Margin="0,0,0,9"
                                 Text="www-root"/>

                        <WrapPanel Grid.Row="8"
                                   Grid.ColumnSpan="2"
                                   Margin="0,4,0,10">

                            <Button x:Name="SaveSshSettingsButton"
                                    Width="170"
                                    Margin="0,0,8,8"
                                    Padding="10,6"
                                    Click="SaveSshSettings_Click"
                                    Content="Сохранить настройки"/>

                            <Button x:Name="ReadSshFingerprintButton"
                                    Width="190"
                                    Margin="0,0,8,8"
                                    Padding="10,6"
                                    Click="ReadSshFingerprint_Click"
                                    Content="Получить fingerprint"/>

                            <Button x:Name="TestSshConnectionButton"
                                    Width="190"
                                    Margin="0,0,8,8"
                                    Padding="10,6"
                                    Click="TestSshConnection_Click"
                                    Content="Проверить подключение"/>

                            <Button x:Name="DeploySelectedSiteButton"
                                    Width="220"
                                    Margin="0,0,0,8"
                                    Padding="10,6"
                                    Click="DeploySelectedSite_Click"
                                    Content="Загрузить выбранный сайт"/>
                            <Button x:Name="DeployDatabaseButton"
                                    Width="260"
                                    Margin="8,0,0,8"
                                    Padding="10,6"
                                    Click="DeployDatabaseButton_Click"
                                    Content="Создать БД и импортировать SQL"/>
                        </WrapPanel>

                        <ProgressBar x:Name="Build3ProgressBar"
                                     Grid.Row="9"
                                     Grid.ColumnSpan="2"
                                     Height="20"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"/>

                        <Border Grid.Row="10"
                                Grid.ColumnSpan="2"
                                Margin="0,12,0,0"
                                Padding="10"
                                Background="#FFF1F1F1"
                                BorderBrush="#FFD0D0D0"
                                BorderThickness="1">
                            <TextBlock x:Name="Build3StatusTextBlock"
                                       TextWrapping="Wrap"
                                       Text="Сборка 3 ещё не проверена."/>
                        </Border>
                        <StackPanel Grid.Row="11"
                                    Grid.ColumnSpan="2"
                                    Margin="0,12,0,0">
                            <ProgressBar x:Name="Build4ProgressBar"
                                         Height="20"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"/>

                            <Border Margin="0,8,0,0"
                                    Padding="10"
                                    Background="#FFEAF5EA"
                                    BorderBrush="#FF9CC79C"
                                    BorderThickness="1">
                                <TextBlock x:Name="Build4StatusTextBlock"
                                           TextWrapping="Wrap"
                                           Text="Сборка 4 ещё не запускалась."/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Задания">
                <DataGrid x:Name="JobsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Домен"
                                            Width="180"
                                            Binding="{Binding Domain}"/>

                        <DataGridTextColumn Header="Статус"
                                            Width="110"
                                            Binding="{Binding Status}"/>

                        <DataGridTemplateColumn Header="Прогресс"
                                                Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="4">
                                        <ProgressBar Height="18"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding Progress}"/>

                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Text="{Binding Progress,
                                                       StringFormat={}{0}%}"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Сообщение"
                                            Width="*"
                                            Binding="{Binding Message}"/>

                        <DataGridTextColumn Header="Результат"
                                            Width="280"
                                            Binding="{Binding OutputPath}"/>

                        <DataGridTextColumn Header="База"
                                            Width="130"
                                            Binding="{Binding DatabaseName}"/>

                        <DataGridTextColumn Header="Пользователь"
                                            Width="130"
                                            Binding="{Binding DatabaseUser}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Предпросмотр">
                <TextBox x:Name="PreviewTextBox"
                         Margin="8"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         Text="Выберите папки и нажмите «Предпросмотр»."/>
            </TabItem>
        </TabControl>

        <GroupBox Grid.Row="4"
                  Header="Журнал"
                  Margin="0,0,0,8">
            <DataGrid x:Name="LogsGrid"
                      Margin="6"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Время"
                                        Width="145"
                                        Binding="{Binding DisplayTime}"/>

                    <DataGridTextColumn Header="Уровень"
                                        Width="80"
                                        Binding="{Binding Level}"/>

                    <DataGridTextColumn Header="Домен"
                                        Width="180"
                                        Binding="{Binding Domain}"/>

                    <DataGridTextColumn Header="Сообщение"
                                        Width="*"
                                        Binding="{Binding Message}"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <Border Grid.Row="5"
                Padding="8"
                Background="#FFF1F1F1"
                BorderBrush="#FFD0D0D0"
                BorderThickness="1">
            <TextBlock x:Name="StatusTextBlock"
                       Text="Готово"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>


