<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>TextFileProcessor</AssemblyName>
    <RootNamespace>TextFileProcessor</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <Version>1.0.0</Version>
    <Company>Local</Company>
    <Product>Domain Site Deployment Manager</Product>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.20" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- Устаревший незавершённый сервис исключён из Сборки 3. -->
  <ItemGroup>
    <Compile Remove="Services\SftpSettingsService.cs" />
      <PackageReference Include="SSH.NET" Version="2026.0.0" />
</ItemGroup>
  <!-- BUILD6_BACKUP_EXCLUSIONS -->
  <ItemGroup>
    <Compile Remove="**/backup-before-build6-*/**/*.cs" />
    <Compile Remove="**/.build*-backup-*/**/*.cs" />
  </ItemGroup>
</Project>