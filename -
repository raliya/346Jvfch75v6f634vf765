   19:     param([string]$Path)
   20: 
   21:     return [IO.File]::ReadAllText($Path).Replace(
   22:         "`r`n",
   23:         "`n"
   24:     ).Replace(
   25:         "`r",
   26:         "`n"
   27:     )
   28: }
