  563:             await Task.Delay(250);
  564:         }
  565:     }
  566: '@
  567: 
  568:     $New = @'
  569:     private async Task RunBuild7LegacyOperationAsync(
  570:         Action startOperation,
  571:         string operationName)
  572:     {
  573:         if (_build7LegacyCompletion is not null &&
  574:             !_build7LegacyCompletion.Task.IsCompleted)
  575:         {
  576:             throw new InvalidOperationException(
  577:                 "Предыдущий этап ещё не завершён.");
  578:         }
  579: 
  580:         var completion =
  581:             new TaskCompletionSource<object?>(
  582:                 TaskCreationOptions.RunContinuationsAsynchronously);
  583: 
  584:         _build7LegacyCompletion = completion;
  585: 
  586:         try
  587:         {
  588:             startOperation();
  589: 
  590:             // Обработчик async void выполняется синхронно до
  591:             // первого await. Если он вернулся, не установив
  592:             // _isRunning, пользователь отказался от подтверждения
  593:             // либо предварительная проверка не позволила запуск.
  594:             await Task.Yield();
  595: 
  596:             if (!completion.Task.IsCompleted &&
  597:                 !_isRunning)
  598:             {
  599:                 completion.TrySetCanceled();
  600:             }
  601: 
  602:             try
  603:             {
  604:                 await completion.Task.WaitAsync(
  605:                     TimeSpan.FromMinutes(65));
  606:             }
  607:             catch (TimeoutException exception)
  608:             {
  609:                 throw new TimeoutException(
  610:                     $"Превышено время ожидания этапа: " +
  611:                     $"{operationName}.",
  612:                     exception);
  613:             }
  614:         }
  615:         finally
  616:         {
  617:             if (ReferenceEquals(
  618:                     _build7LegacyCompletion,
  619:                     completion))
  620:             {
  621:                 _build7LegacyCompletion = null;
  622:             }
  623:         }
  624:     }
  625: 
  626:     private void CompleteBuild7LegacyOperation()
  627:     {
  628:         _build7LegacyCompletion?.TrySetResult(null);
  629:     }
